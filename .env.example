# URL base da API (sem barra no final). Valores VITE_* são embutidos no bundle em tempo de build.
VITE_API_URL=http://localhost:5399

# Endereço público do site: base do canonical e do Open Graph. Em desenvolvimento pode ficar vazio.
VITE_SITE_URL=

# ID do cliente OAuth do "Entrar com o Google" (veja o README da raiz). Vazio = sem o botão.
VITE_GOOGLE_CLIENT_ID=
